# Copy this file to .env and adjust the values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local MongoDB Community Server (free, runs on your laptop)
MONGODB_URI=mongodb://127.0.0.1:27017/airbnb_soa?replicaSet=rs0

# Used only by `npm test`. Must be a separate database: the tests wipe it.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/airbnb_soa_test

# Comma-separated list of frontend origins allowed by CORS.
# Use * only for quick local experiments, never in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Private server-side booking-management code (at least 32 characters).
# Never use a VITE_ variable or commit an actual value.
ADMIN_API_TOKEN=

# Booking transactions require MongoDB replica set (Compose or the demo runner).
# Example: mongodb://localhost:27017/airbnb_soa?replicaSet=rs0
MONGO_MAX_POOL_SIZE=20
METRICS_ENABLED=false
METRICS_ENVIRONMENT=development
# Enable only on a dedicated *_loadtest database, never normal guest data.
LOAD_TEST_DATA_ENABLED=false
